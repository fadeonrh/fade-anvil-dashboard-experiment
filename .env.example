# OpenSea API key (optional, enables floor/offer data)
# Get one at https://docs.opensea.io/reference/request-an-api-key
OPENSEA_API_KEY=

# Custom RPC URL (optional, defaults to public Robinhood RPC)
# ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# RPC rate limiting (optional)
# RPC_RPS=2
# RPC_BURST=3
