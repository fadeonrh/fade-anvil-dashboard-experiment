{
  "name": "fade-anvil-dashboard",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Public Anvil AMM dashboard for Robinhood Chain (4663) — real-time spread data",
  "bin": {
    "fade-anvil": "./bin/fade-anvil.js"
  },
  "scripts": {
    "dev": "vercel dev",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx --test tests/**/*.test.ts",
    "test:unit": "npx tsx --test tests/unit/**/*.test.ts",
    "test:integration": "npx tsx --test tests/integration/**/*.test.ts",
    "start": "npx tsx bin/fade-anvil.js"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3",
    "vercel": "^44.0.0"
  },
  "dependencies": {
    "viem": "^2.56.0"
  }
}
