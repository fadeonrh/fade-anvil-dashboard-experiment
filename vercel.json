{
  "version": 2,
  "builds": [
    {
      "src": "api/health.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/markets.ts",
      "use": "@vercel/node"
    },
    {
      "src": "api/analytics.ts",
      "use": "@vercel/node"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/analytics",
      "dest": "/public/analytics.html"
    },
    {
      "src": "/analytics.html",
      "dest": "/public/analytics.html"
    },
    {
      "src": "/openapi.json",
      "dest": "/public/openapi.json"
    },
    {
      "src": "/404.html",
      "dest": "/public/404.html"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
